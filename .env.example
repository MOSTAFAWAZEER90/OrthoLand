# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL credentials used by the API and docker-compose services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=OrthoFlowAI

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Secret key for JWT token signing. MUST be at least 32 characters.
# Generate a strong key: openssl rand -base64 64
JWT_SECRET_KEY=OrthoFlowAI_SuperSecretKey_2024_MustBe32CharsLong!
JWT_ISSUER=OrthoFlowAI
JWT_AUDIENCE=OrthoFlowAI

# ─── SendGrid (Email) ────────────────────────────────────────────────────────
# Get your API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# ─── OpenAI (AI Features) ────────────────────────────────────────────────────
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# For development: http://localhost:5001,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5001

# ─── Docker Compose Project ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=orthoflowai
