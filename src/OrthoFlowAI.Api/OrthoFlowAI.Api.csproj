<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8fd8ed66-93fe-42a7-9e18-b988384c27ab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrthoFlowAI.Application\OrthoFlowAI.Application.csproj" />
    <ProjectReference Include="..\OrthoFlowAI.Infrastructure\OrthoFlowAI.Infrastructure.csproj" />
    <ProjectReference Include="..\OrthoFlowAI.Domain\OrthoFlowAI.Domain.csproj" />
  </ItemGroup>

  <!-- When the Web app hosts the API, the Web's own appsettings*.json (which contain the
       API settings too) are used; don't copy the API's files over them. -->
  <ItemGroup Condition="'$(OrthoFlowHostedInWeb)' == 'true'">
    <Content Update="appsettings*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
