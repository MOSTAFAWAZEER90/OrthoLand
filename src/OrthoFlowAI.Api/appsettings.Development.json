{
  "//": "DEVELOPMENT ONLY. These values are public (committed to git). Production must supply its own via environment variables or a secret store; the API refuses to start in Production with these values.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=OrthoFlowAI;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "SecretKey": "OrthoFlowAI_DEV_ONLY_Key_NotForProduction_0123456789"
  },
  "Seed": {
    "DemoData": true,
    "SuperAdminPassword": "Admin@123"
  },
  "WhatsApp": {
    "Provider": "Log"
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  }
}
