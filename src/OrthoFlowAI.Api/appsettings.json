{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=OrthoFlowAI;Username=postgres;Password=postgres;Include Error Detail=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "OrthoFlowAI_SuperSecretKey_2024_MustBe32CharsLong!",
    "Issuer": "OrthoFlowAI",
    "Audience": "OrthoFlowAI",
    "ExpirationInMinutes": 60,
    "RefreshExpirationInDays": 7
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "noreply@orthoflowai.com",
    "FromName": "OrthoFlowAI"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxTokens": 2000,
    "Temperature": 0.7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Cors": {
    "AllowAllOrigins": true,
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "https://orthoflowai.com" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*", "Authorization", "Content-Type", "X-Tenant-Id" ],
    "AllowCredentials": true
  }
}
