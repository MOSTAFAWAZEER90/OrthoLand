@namespace OrthoFlowAI.Web.Components.Shared
@inject IApiService ApiService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div style="display:flex;align-items:center;gap:0.75rem;">
            <MudIcon Icon="@Icons.Material.Filled.EmergencyShare" Color="Color.Error" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Style="font-weight:600;">Emergency Request</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="background:var(--danger-light);color:var(--danger);padding:0.75rem;border-radius:var(--radius-md);margin-bottom:1rem;">
            <MudText Typo="Typo.body2" Style="font-weight:600;">
                If you are experiencing a dental emergency, submit this request and the clinic will contact you immediately.
            </MudText>
        </div>

        <MudSelect T="EmergencySeverity" @bind-Value="_severity" Label="Severity" Variant="Variant.Outlined"
                   Margin="Margin.Dense" FullWidth="true">
            <MudSelectItem T="EmergencySeverity" Value="EmergencySeverity.Low">Low</MudSelectItem>
            <MudSelectItem T="EmergencySeverity" Value="EmergencySeverity.Medium">Medium</MudSelectItem>
            <MudSelectItem T="EmergencySeverity" Value="EmergencySeverity.High">High</MudSelectItem>
            <MudSelectItem T="EmergencySeverity" Value="EmergencySeverity.Critical">Critical</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="_description" Label="Describe the problem" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="margin-top:0.75rem;" FullWidth="true" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Style="margin-right:0.5rem;">Cancel</MudButton>
        <MudButton OnClick="Submit" Style="background:var(--danger);color:white;" Disabled="_submitting">
            @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> } else { @("Submit Emergency") }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private EmergencySeverity _severity = EmergencySeverity.Medium;
    private string _description = "";
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_description))
        {
            Snackbar.Add("Please describe the problem", Severity.Warning);
            return;
        }

        _submitting = true;
        StateHasChanged();

        try
        {
            var r = await ApiService.PostAsync<ApiResponse<PortalEmergencyResponse>>(
                "api/portal/emergency", new PortalEmergencyRequest { Severity = _severity, Description = _description });

            if (r?.Success == true)
            {
                Snackbar.Add("Emergency request submitted. Help is on the way.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to submit emergency request", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }
}
