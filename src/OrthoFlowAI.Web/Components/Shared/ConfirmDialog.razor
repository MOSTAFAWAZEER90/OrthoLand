@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div style="display:flex;align-items:center;gap:0.75rem;">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Style="font-weight:600;">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Style="color:var(--text-secondary);">@Message</MudText>
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Style="margin-right:0.5rem;">@CancelText</MudButton>
        <MudButton OnClick="Confirm" Color="Color.Primary" Variant="Variant.Filled" Style="color:white;">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }
}
