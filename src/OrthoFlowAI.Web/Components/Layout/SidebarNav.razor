@inject NavigationManager Navigation
@inject IAuthService AuthService
@using OrthoFlowAI.Domain.Enums

<div style="display:flex;flex-direction:column;height:100%;padding:0;">
    <div style="padding:1.25rem 1rem;display:flex;align-items:center;gap:0.75rem;border-bottom:1px solid rgba(255,255,255,0.06);">
        <div style="width:36px;height:36px;border-radius:10px;background:var(--accent-gradient);display:flex;align-items:center;justify-content:center;">
            <MudIcon Icon="Icons.Material.Filled.Paragliding" Size="Size.Small" Style="color:white;" />
        </div>
        @if (!IsCollapsed)
        {
            <div>
                <MudText Style="color:white;font-weight:700;font-size:1rem;line-height:1.2;">OrthoFlowAI</MudText>
                <MudText Style="color:rgba(255,255,255,0.4);font-size:0.6875rem;font-weight:500;">Dental Management</MudText>
            </div>
        }
    </div>

    <div style="flex:1;overflow-y:auto;padding:0.75rem 0;">
        <MudNavMenu>
            @foreach (var navItem in _navItems)
            {
                var isActive = IsNavLinkActive(navItem.Href);
                <MudNavLink Href="@navItem.Href"
                            Match="@navItem.Match"
                            Icon="@navItem.Icon"
                            Class="@(isActive ? "active" : "")"
                            Style="color:var(--text-sidebar);">
                    @if (!IsCollapsed)
                    {
                        @navItem.Label
                    }
                </MudNavLink>
            }
        </MudNavMenu>
    </div>

    @if (!IsCollapsed)
    {
        <div style="padding:1rem;border-top:1px solid rgba(255,255,255,0.06);">
            <div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem;border-radius:var(--radius-md);background:rgba(99,102,241,0.1);">
                <MudAvatar Size="Size.Small" Style="background:var(--accent-gradient);color:white;font-weight:600;">
                    DR
                </MudAvatar>
                <div style="flex:1;min-width:0;">
                    <MudText Style="color:white;font-weight:600;font-size:0.8125rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        Dr. Admin
                    </MudText>
                    <MudText Style="color:rgba(255,255,255,0.4);font-size:0.6875rem;">Clinic Owner</MudText>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public bool IsCollapsed { get; set; }

    private List<NavItem> _navItems = new()
    {
        new("/dashboard", Icons.Material.Filled.Dashboard, "Dashboard", NavLinkMatch.All),
        new(null!, null!, null!, default),
        new("/portal", Icons.Material.Filled.AccountCircle, "Patient Portal", NavLinkMatch.Prefix),
        new("/patients", Icons.Material.Filled.People, "Patients", NavLinkMatch.Prefix),
        new("/appointments", Icons.Material.Filled.CalendarMonth, "Appointments", NavLinkMatch.Prefix),
        new("/invoices", Icons.Material.Filled.Receipt, "Invoices", NavLinkMatch.Prefix),
        new(null!, null!, null!, default),
        new("/inventory", Icons.Material.Filled.Inventory2, "Inventory", NavLinkMatch.Prefix),
        new("/staff", Icons.Material.Filled.Badge, "Staff", NavLinkMatch.Prefix),
        new("/branches", Icons.Material.Filled.Storefront, "Branches", NavLinkMatch.Prefix),
        new("/analytics", Icons.Material.Filled.Insights, "Analytics", NavLinkMatch.Prefix),
        new(null!, null!, null!, default),
        new("/ai", Icons.Material.Filled.AutoAwesome, "AI Assistant", NavLinkMatch.Prefix),
        new("/settings", Icons.Material.Filled.Settings, "Settings", NavLinkMatch.Prefix),
    };

    private List<NavItem> _adminNavItems = new()
    {
        new(null!, null!, null!, default),
        new("/super-admin", Icons.Material.Filled.Security, "Super Admin", NavLinkMatch.Prefix),
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user?.Role == UserRole.SuperAdmin)
        {
            _navItems.AddRange(_adminNavItems);
        }
    }

    private bool IsNavLinkActive(string? href)
    {
        if (href == null) return false;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        return uri.AbsolutePath.Equals(href, StringComparison.OrdinalIgnoreCase)
            || (href != "/" && uri.AbsolutePath.StartsWith(href, StringComparison.OrdinalIgnoreCase));
    }

    record NavItem(string Href, string Icon, string Label, NavLinkMatch Match);
}
