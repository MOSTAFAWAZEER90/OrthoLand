<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/mud-theme.css"]" />
    <link rel="stylesheet" href="@Assets["OrthoFlowAI.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="mud-typography">
    <Routes />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        window.toggleDarkMode = () => {
            const html = document.documentElement;
            if (html.classList.contains('dark-mode')) {
                html.classList.remove('dark-mode');
                localStorage.setItem('orthoflow-theme', 'light');
            } else {
                html.classList.add('dark-mode');
                localStorage.setItem('orthoflow-theme', 'dark');
            }
        };
        window.getStoredTheme = () => localStorage.getItem('orthoflow-theme');
        window.applyStoredTheme = () => {
            const theme = localStorage.getItem('orthoflow-theme');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark-mode');
            }
        };
    </script>
</body>

</html>
