@code {
    // No prerendering: pages load data with the user's token, which only exists in the
    // browser (sessionStorage). Prerendering ran every API call twice, the first always 401.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/mud-theme.css"]" />
    <link rel="stylesheet" href="@Assets["OrthoFlowAI.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body class="mud-typography">
    <Routes @rendermode="InteractiveNoPrerender" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Saves bytes fetched through the API (e.g. invoice PDF) as a file.
        window.orthoflowDownload = (fileName, base64, mime) => {
            const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
            const url = URL.createObjectURL(new Blob([bytes], { type: mime || 'application/octet-stream' }));
            const a = document.createElement('a');
            a.href = url; a.download = fileName; document.body.appendChild(a); a.click(); a.remove();
            setTimeout(() => URL.revokeObjectURL(url), 10000);
        };
        // Opens WhatsApp click-to-chat (wa.me) in a new tab.
        window.orthoflowOpen = (url) => window.open(url, '_blank', 'noopener');
        window.toggleDarkMode = () => {
            const html = document.documentElement;
            if (html.classList.contains('dark-mode')) {
                html.classList.remove('dark-mode');
                localStorage.setItem('orthoflow-theme', 'light');
            } else {
                html.classList.add('dark-mode');
                localStorage.setItem('orthoflow-theme', 'dark');
            }
        };
        window.getStoredTheme = () => localStorage.getItem('orthoflow-theme');
        window.applyStoredTheme = () => {
            const theme = localStorage.getItem('orthoflow-theme');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark-mode');
            }
        };
    </script>
</body>

</html>
