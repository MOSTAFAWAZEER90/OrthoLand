@page "/patients/{Id}"
@rendermode InteractiveServer
@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Patient Profile - OrthoFlowAI</PageTitle>

@if (_loading)
{
    <LoadingSpinner Message="Loading patient profile..." />
}
else if (_patient == null)
{
    <div style="text-align:center;padding:3rem;">
        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Style="color:var(--text-tertiary);" />
        <MudText Typo="Typo.h6" Style="color:var(--text-secondary);margin-top:1rem;">Patient not found</MudText>
        <MudButton Href="/patients" Variant="Variant.Outlined" Style="margin-top:1rem;">Back to Patients</MudButton>
    </div>
}
else
{
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/patients"))"
                       Style="color:var(--text-secondary);" />
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800;">
                @_patient.FirstName @_patient.LastName
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">Patient profile and treatment history</MudText>
        </div>
    </div>

    <MudCard Class="content-card" Style="margin-bottom:1.5rem;">
        <div style="padding:1.5rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
            <MudAvatar Style="width:72px;height:72px;font-size:1.5rem;background:var(--accent-gradient);color:white;font-weight:700;">
                @($"{_patient.FirstName[0]}{_patient.LastName[0]}")
            </MudAvatar>
            <div style="flex:1;min-width:200px;">
                <MudText Typo="Typo.h5" Style="font-weight:700;">@($"{_patient.FirstName} {_patient.LastName}")</MudText>
                <div style="display:flex;gap:1rem;margin-top:0.5rem;flex-wrap:wrap;">
                    @if (!string.IsNullOrEmpty(_patient.Email))
                    {
                        <div style="display:flex;align-items:center;gap:0.25rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Style="color:var(--text-tertiary);" />
                            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">@_patient.Email</MudText>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_patient.Phone))
                    {
                        <div style="display:flex;align-items:center;gap:0.25rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Style="color:var(--text-tertiary);" />
                            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">@_patient.Phone</MudText>
                        </div>
                    }
                    @if (_patient.DateOfBirth.HasValue)
                    {
                        <div style="display:flex;align-items:center;gap:0.25rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" Style="color:var(--text-tertiary);" />
                            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">@_patient.DateOfBirth.Value.ToString("MMM dd, yyyy")</MudText>
                        </div>
                    }
                </div>
            </div>
            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                <div style="text-align:center;">
                    <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--accent-primary);font-size:1.25rem;">
                        @_patient.JourneyScore.ToString("F0")%
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Journey Score</MudText>
                </div>
                <div style="text-align:center;">
                    <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--success);font-size:1.25rem;">
                        @_patient.ComplianceScore.ToString("F0")%
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Compliance</MudText>
                </div>
                <MudChip T="string" Style="@GetStatusStyle(_patient.Status)">
                    @_patient.Status
                </MudChip>
            </div>
        </div>
    </MudCard>

    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0"
             Style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius-lg);">
        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
            <div style="padding:1.5rem;">
                <MudGrid >
                    <MudItem xs="12" md="6">
                        <MudCard Style="background:var(--bg-tertiary);border:none;">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:1rem;">Treatment Information</MudText>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Treatment Type</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                                            @(_patient.TreatmentType?.ToString() ?? "Not assigned")
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Doctor</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                                            @(_patient.DoctorName ?? "Unassigned")
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Start Date</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                                            @(_patient.TreatmentStartDate?.ToString("MMM dd, yyyy") ?? "—")
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Est. End Date</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                                            @(_patient.EstimatedEndDate?.ToString("MMM dd, yyyy") ?? "—")
                                        </MudText>
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Style="background:var(--bg-tertiary);border:none;">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:1rem;">Financial Summary</MudText>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Total Cost</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--text-primary);">
                                            $@_patient.TotalTreatmentCost.ToString("N0")
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Paid</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--success);">
                                            $@_patient.AmountPaid.ToString("N0")
                                        </MudText>
                                    </div>
                                    <div style="grid-column:span 2;">
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">Remaining</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--danger);">
                                            $@_patient.AmountRemaining.ToString("N0")
                                        </MudText>
                                        @if (_patient.TotalTreatmentCost > 0)
                                        {
                                            var paidPercent = (int)(_patient.AmountPaid / _patient.TotalTreatmentCost * 100);
                                            <MudProgressLinear Value="@paidPercent" Color="Color.Primary"
                                                               Style="margin-top:0.5rem;border-radius:9999px;" />
                                        }
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_patient.Diagnosis))
                    {
                        <MudItem xs="12">
                            <MudCard Style="background:var(--bg-tertiary);border:none;">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:0.5rem;">Diagnosis</MudText>
                                    <MudText Typo="Typo.body2" Style="color:var(--text-secondary);line-height:1.8;">
                                        @_patient.Diagnosis
                                    </MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                    @if (!string.IsNullOrEmpty(_patient.TreatmentPlanDescription))
                    {
                        <MudItem xs="12">
                            <MudCard Style="background:var(--bg-tertiary);border:none;">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:0.5rem;">Treatment Plan</MudText>
                                    <MudText Typo="Typo.body2" Style="color:var(--text-secondary);line-height:1.8;">
                                        @_patient.TreatmentPlanDescription
                                    </MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Timeline" Icon="@Icons.Material.Filled.Timeline">
            <div style="padding:1.5rem;">
                <PatientTimeline PatientId="@_patient!.Id" ApiService="ApiService" Snackbar="Snackbar" />
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Photos" Icon="@Icons.Material.Filled.PhotoLibrary">
            <div style="padding:1.5rem;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:0.75rem;">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight:600;">Photo Gallery</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--text-tertiary);">Upload photos to track the treatment journey</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Style="color:white;" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenUploadDialog">
                        Upload Photo
                    </MudButton>
                </div>

                @if (_photosLoading)
                {
                    <LoadingSpinner Message="Loading photos..." />
                }
                else if (_photos.Count == 0)
                {
                    <div style="text-align:center;padding:2.5rem;">
                        <MudIcon Icon="@Icons.Material.Filled.PhotoCameraBack" Size="Size.Large" Style="color:var(--text-tertiary);opacity:0.5;" />
                        <MudText Typo="Typo.body2" Style="color:var(--text-tertiary);margin-top:0.5rem;">
                            No photos yet. Upload the first photo to begin tracking progress.
                        </MudText>
                    </div>
                }
                else
                {
                    @if (_comparisons.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;color:var(--accent-primary);margin-bottom:0.75rem;margin-top:0.5rem;">
                            Before / After Comparison
                        </MudText>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem;margin-bottom:1.5rem;">
                            @foreach (var cmp in _comparisons)
                            {
                                <MudCard Class="content-card" Style="overflow:hidden;">
                                    <div style="aspect-ratio:4/3;max-height:280px;overflow:hidden;">
                                        <BeforeAfterSlider BeforeUrl="@ApiService.GetFullUrl(cmp.BeforePhotoUrl)"
                                                          AfterUrl="@ApiService.GetFullUrl(cmp.AfterPhotoUrl)" />
                                    </div>
                                    <MudCardContent>
                                        <div style="display:flex;justify-content:space-between;align-items:center;">
                                            <div>
                                                <MudText Typo="Typo.body2" Style="font-weight:600;">@cmp.Category</MudText>
                                                @if (cmp.VisitDate.HasValue)
                                                {
                                                    <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">@cmp.VisitDate.Value.ToString("MMM dd, yyyy")</MudText>
                                                }
                                            </div>
                                            @if (cmp.ComparisonScore.HasValue)
                                            {
                                                <MudChip T="string" Style="background:var(--info-light);color:var(--info);font-weight:600;">
                                                    @cmp.ComparisonScore.Value.ToString("F0")% match
                                                </MudChip>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(cmp.Description))
                                        {
                                            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);margin-top:0.5rem;line-height:1.6;">@cmp.Description</MudText>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            }
                        </div>
                    }

                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;color:var(--text-secondary);margin-bottom:0.75rem;margin-top:0.5rem;">
                        All Photos (@_photos.Count)
                    </MudText>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;">
                        @foreach (var photo in _photos)
                        {
                            <MudCard Class="content-card" Style="overflow:hidden;">
                                <div style="aspect-ratio:1/1;overflow:hidden;position:relative;">
                                    <img src="@ApiService.GetFullUrl(photo.Url)" alt="@photo.FileName"
                                         style="width:100%;height:100%;object-fit:cover;display:block;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Style="position:absolute;top:0.5rem;right:0.5rem;background:rgba(0,0,0,0.55);color:white;"
                                                   OnClick="@(() => DeletePhoto(photo.Id))" />
                                </div>
                                <MudCardContent Style="padding:0.75rem;">
                                    <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
                                        <MudText Typo="Typo.caption" Style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @photo.Category
                                        </MudText>
                                    </div>
                                    @if (photo.VisitDate.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">@photo.VisitDate.Value.ToString("MMM dd, yyyy")</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Appointments" Icon="@Icons.Material.Filled.CalendarMonth">
            <div style="padding:1.5rem;">
                <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">Patient appointments coming soon.</MudText>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Invoices" Icon="@Icons.Material.Filled.Receipt">
            <div style="padding:1.5rem;">
                <MudText Typo="Typo.body2" Style="color:var(--text-secondary);">Patient invoices coming soon.</MudText>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.Notes">
            <div style="padding:1.5rem;">
                @if (!string.IsNullOrEmpty(_patient.Notes))
                {
                    <MudCard Style="background:var(--bg-tertiary);border:none;">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Style="color:var(--text-secondary);line-height:1.8;">
                                @_patient.Notes
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color:var(--text-tertiary);">No notes yet.</MudText>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private PatientResponse? _patient;
    private bool _loading = true;
    private int _activeTab = 0;

    private List<PhotoResponse> _photos = new();
    private List<BeforeAfterComparisonResponse> _comparisons = new();
    private bool _photosLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatient();
        if (_patient != null)
        {
            await LoadPhotos();
        }
    }

    private async Task LoadPhotos()
    {
        if (_patient == null) return;
        _photosLoading = true;
        StateHasChanged();

        try
        {
            var photoResult = await ApiService.GetAsync<ApiResponse<PagedResult<PhotoResponse>>>($"api/photos?patientId={_patient.Id}&pageNumber=1&pageSize=200");
            if (photoResult?.Success == true && photoResult.Data != null)
            {
                _photos = photoResult.Data.Items ?? new();
            }

            var cmpResult = await ApiService.GetAsync<ApiResponse<List<BeforeAfterComparisonResponse>>>($"api/photos/comparisons?patientId={_patient.Id}");
            if (cmpResult?.Success == true && cmpResult.Data != null)
            {
                _comparisons = cmpResult.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load photos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _photosLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenUploadDialog()
    {
        var parameters = new DialogParameters<PhotoUploadDialog>
        {
            { x => x.PatientId, _patient!.Id }
        };
        var dialog = await DialogService.ShowAsync<PhotoUploadDialog>("Upload Photo", parameters);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadPhotos();
        }
    }

    private async Task DeletePhoto(string photoId)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Delete Photo" },
            { x => x.Message, "Are you sure you want to delete this photo? This action cannot be undone." },
            { x => x.ConfirmText, "Delete" },
            { x => x.OnConfirm, EventCallback.Factory.Create(this, async () =>
            {
                var deleted = await ApiService.DeleteAsync<ApiResponse>($"api/photos/{photoId}");
                if (deleted?.Success == true)
                {
                    Snackbar.Add("Photo deleted", Severity.Success);
                    await LoadPhotos();
                }
                else
                {
                    Snackbar.Add("Failed to delete photo", Severity.Error);
                }
            })}
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ConfirmDialog>("Delete Confirmation", parameters, options);
    }

    private async Task LoadPatient()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _patient = await ApiService.GetAsync<PatientResponse>($"api/patients/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load patient: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetStatusStyle(PatientStatus status) => status switch
    {
        PatientStatus.Active => "background:var(--success-light);color:var(--success);font-weight:600;",
        PatientStatus.Inactive => "background:var(--warning-light);color:var(--warning);font-weight:600;",
        PatientStatus.Completed => "background:var(--info-light);color:var(--info);font-weight:600;",
        PatientStatus.OnHold => "background:rgba(156,163,175,0.15);color:#6b7280;font-weight:600;",
        PatientStatus.Cancelled => "background:var(--danger-light);color:var(--danger);font-weight:600;",
        _ => "background:var(--bg-tertiary);"
    };
}
