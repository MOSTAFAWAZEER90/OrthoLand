@page "/appointments"
@rendermode InteractiveServer
@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Appointments - OrthoFlowAI</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:800;">Appointments</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-secondary);margin-top:0.25rem;">
            Manage appointments and schedule
        </MudText>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center;">
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
            <MudButton OnClick="@(() => _viewMode = "month")"
                       Class="@(_viewMode == "month" ? "mud-button-filled" : "")">Month</MudButton>
            <MudButton OnClick="@(() => _viewMode = "week")"
                       Class="@(_viewMode == "week" ? "mud-button-filled" : "")">Week</MudButton>
            <MudButton OnClick="@(() => _viewMode = "day")"
                       Class="@(_viewMode == "day" ? "mud-button-filled" : "")">Day</MudButton>
        </MudButtonGroup>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                   OnClick="OpenCreateDialog" Style="color:white;">
            New Appointment
        </MudButton>
    </div>
</div>

<div style="display:flex;gap:1rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousPeriod" Size="Size.Medium"
                   Style="color:var(--text-secondary);" />
    <MudText Typo="Typo.h6" Style="font-weight:700;min-width:200px;text-align:center;">
        @GetCurrentPeriodLabel()
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextPeriod" Size="Size.Medium"
                   Style="color:var(--text-secondary);" />
    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoToToday"
               Style="color:var(--accent-primary);margin-left:0.5rem;">Today</MudButton>
    <div style="flex:1;"></div>
    <MudSelect T="AppointmentStatus?" @bind-Value="_statusFilter" Label="Status"
               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
               Style="min-width:160px;">
        <MudSelectItem T="AppointmentStatus?" Value="null">All</MudSelectItem>
        <MudSelectItem T="AppointmentStatus?" Value="AppointmentStatus.Scheduled">Scheduled</MudSelectItem>
        <MudSelectItem T="AppointmentStatus?" Value="AppointmentStatus.Confirmed">Confirmed</MudSelectItem>
        <MudSelectItem T="AppointmentStatus?" Value="AppointmentStatus.Completed">Completed</MudSelectItem>
        <MudSelectItem T="AppointmentStatus?" Value="AppointmentStatus.Cancelled">Cancelled</MudSelectItem>
        <MudSelectItem T="AppointmentStatus?" Value="AppointmentStatus.NoShow">No Show</MudSelectItem>
    </MudSelect>
</div>

@if (_loading)
{
    <LoadingSpinner Message="Loading appointments..." />
}
else
{
    <MudCard Class="content-card">
        @if (_viewMode == "month")
        {
            <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--border-color);">
                @foreach (var dayName in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <div style="padding:0.75rem;text-align:center;background:var(--bg-tertiary);font-weight:600;font-size:0.75rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;">
                        @dayName
                    </div>
                }
                @foreach (var day in GetCalendarDays())
                {
                    var isToday = day.Date == DateTime.Today;
                    var isCurrentMonth = day.Month == _currentMonth.Month;
                    var dayAppointments = GetAppointmentsForDay(day);

                    var todayStyle = isToday ? "border:2px solid var(--accent-primary);" : "";
                    var monthStyle = isCurrentMonth ? "" : "opacity:0.4;";

                    var dayStyle = $"min-height:100px;padding:0.5rem;background:var(--bg-card);{todayStyle}{monthStyle}";

                    <div style="@dayStyle">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.25rem;">
                            <span style="font-weight:600;font-size:0.8125rem;color:@(isToday ? "var(--accent-primary)" : "var(--text-primary)");">
                                @day.Day
                            </span>
                            @if (dayAppointments.Any())
                            {
                                <span style="font-size:0.6875rem;color:var(--text-tertiary);">@dayAppointments.Count</span>
                            }
                        </div>
                        @foreach (var appt in dayAppointments.Take(3))
                        {
                            <div style="padding:2px 6px;border-radius:4px;font-size:0.6875rem;font-weight:500;margin-bottom:2px;cursor:pointer;@(GetTypeColor(appt.Type))"
                                 @onclick="@(() => ShowAppointmentDetails(appt))">
                                @appt.AppointmentDate.ToString("HH:mm") @appt.PatientName.Split(' ').FirstOrDefault()
                            </div>
                        }
                        @if (dayAppointments.Count > 3)
                        {
                            <div style="font-size:0.625rem;color:var(--accent-primary);padding:2px 6px;cursor:pointer;">
                                +@(dayAppointments.Count - 3) more
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding:1.5rem;">
                @if (_appointments.Any())
                {
                    @foreach (var appt in _appointments.OrderBy(a => a.AppointmentDate))
                    {
                        <div class="appointment-row"
                             style="display:flex;align-items:center;gap:1rem;padding:1rem;border-radius:var(--radius-md);border:1px solid var(--border-color);margin-bottom:0.5rem;cursor:pointer;transition:all var(--transition-fast);"
                             @onclick="@(() => ShowAppointmentDetails(appt))">
                            <div style="width:4px;height:48px;border-radius:2px;@(GetTypeColor(appt.Type))"></div>
                            <div style="min-width:80px;text-align:center;">
                                <MudText Typo="Typo.body2" Style="font-weight:700;">@appt.AppointmentDate.ToString("HH:mm")</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--text-tertiary);">@appt.Duration min</MudText>
                            </div>
                            <div style="flex:1;">
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@appt.PatientName</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--text-secondary);">
                                    @appt.Type - Dr. @appt.DoctorName
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Style="@GetStatusChipStyle(appt.Status)">
                                @appt.Status
                            </MudChip>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center;padding:3rem;">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" Style="color:var(--text-tertiary);" />
                        <MudText Typo="Typo.body1" Style="color:var(--text-secondary);margin-top:0.75rem;">No appointments found</MudText>
                    </div>
                }
            </div>
        }
    </MudCard>
}

@code {
    private List<AppointmentResponse> _appointments = new();
    private bool _loading = true;
    private string _viewMode = "month";
    private DateTime _currentMonth = DateTime.Today;
    private AppointmentStatus? _statusFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var filter = new AppointmentFilterRequest
            {
                PageNumber = 1,
                PageSize = 200,
                DateFrom = new DateTime(_currentMonth.Year, _currentMonth.Month, 1),
                DateTo = new DateTime(_currentMonth.Year, _currentMonth.Month, 1).AddMonths(1).AddDays(-1),
                Status = _statusFilter
            };

            var result = await ApiService.PostAsync<PaginatedApiResponse<AppointmentResponse>>("api/appointments/filter", filter);
            _appointments = result?.Success == true ? result.Data : new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load appointments: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetCurrentPeriodLabel() => _viewMode switch
    {
        "month" => _currentMonth.ToString("MMMM yyyy"),
        "week" => $"Week of {_currentMonth.ToString("MMM dd, yyyy")}",
        "day" => _currentMonth.ToString("EEEE, MMMM dd, yyyy"),
        _ => _currentMonth.ToString("MMMM yyyy")
    };

    private void PreviousPeriod()
    {
        _currentMonth = _viewMode switch
        {
            "month" => _currentMonth.AddMonths(-1),
            "week" => _currentMonth.AddDays(-7),
            "day" => _currentMonth.AddDays(-1),
            _ => _currentMonth.AddMonths(-1)
        };
        _ = LoadAppointments();
    }

    private void NextPeriod()
    {
        _currentMonth = _viewMode switch
        {
            "month" => _currentMonth.AddMonths(1),
            "week" => _currentMonth.AddDays(7),
            "day" => _currentMonth.AddDays(1),
            _ => _currentMonth.AddMonths(1)
        };
        _ = LoadAppointments();
    }

    private void GoToToday()
    {
        _currentMonth = DateTime.Today;
        _ = LoadAppointments();
    }

    private List<DateTime> GetCalendarDays()
    {
        var firstDay = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        var startDay = firstDay.AddDays(-((int)firstDay.DayOfWeek + 5) % 7);
        return Enumerable.Range(0, 42).Select(i => startDay.AddDays(i)).ToList();
    }

    private List<AppointmentResponse> GetAppointmentsForDay(DateTime day)
    {
        return _appointments.Where(a => a.AppointmentDate.Date == day.Date).ToList();
    }

    private void ShowAppointmentDetails(AppointmentResponse appt)
    {
        Snackbar.Add($"Appointment: {appt.PatientName} at {appt.AppointmentDate:HH:mm}", Severity.Info);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<AppointmentDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Model, new CreateAppointmentRequest { Duration = 30, Type = AppointmentType.Adjustment } }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AppointmentDialog>("New Appointment", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAppointments();
        }
    }

    private string GetTypeColor(AppointmentType type) => type switch
    {
        AppointmentType.Consultation => "background:var(--info-light);color:var(--info);",
        AppointmentType.Adjustment => "background:var(--success-light);color:var(--success);",
        AppointmentType.Emergency => "background:var(--danger-light);color:var(--danger);",
        AppointmentType.FollowUp => "background:var(--warning-light);color:var(--warning);",
        AppointmentType.Cleaning => "background:rgba(99,102,241,0.1);color:var(--accent-primary);",
        _ => "background:var(--bg-tertiary);color:var(--text-secondary);"
    };

    private string GetStatusChipStyle(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Scheduled => "background:var(--info-light);color:var(--info);font-weight:600;",
        AppointmentStatus.Confirmed => "background:rgba(99,102,241,0.1);color:var(--accent-primary);font-weight:600;",
        AppointmentStatus.Completed => "background:var(--success-light);color:var(--success);font-weight:600;",
        AppointmentStatus.Cancelled => "background:var(--danger-light);color:var(--danger);font-weight:600;",
        AppointmentStatus.NoShow => "background:var(--warning-light);color:var(--warning);font-weight:600;",
        AppointmentStatus.InProgress => "background:var(--info-light);color:var(--info);font-weight:600;",
        _ => "background:var(--bg-tertiary);"
    };
}
