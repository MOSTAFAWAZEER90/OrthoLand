@page "/not-found"
@layout LoginLayout

<PageTitle>Not Found - OrthoFlowAI</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-primary);">
    <div style="text-align:center;padding:2rem;">
        <MudText Typo="Typo.h1" Style="font-weight:800;font-size:6rem;color:var(--accent-primary);">404</MudText>
        <MudText Typo="Typo.h5" Style="font-weight:600;margin-top:1rem;">Page Not Found</MudText>
        <MudText Typo="Typo.body1" Style="color:var(--text-secondary);margin-top:0.5rem;">
            The page you're looking for doesn't exist.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Style="margin-top:1.5rem;color:white;">
            Go to Dashboard
        </MudButton>
    </div>
</div>
